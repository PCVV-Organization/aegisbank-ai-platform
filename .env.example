# ==============================================================================
# AegisBank AI Platform — Environment Template
# ==============================================================================
# Copy this file to .env.local at the application root for local development.
# The agent also discovers it from child working directories unless a closer
# ai/agent/.env.local exists.
# Process environment variables take precedence over values from this file.
# NEVER COMMIT REAL SECRETS, CREDENTIALS, OR A .env.production FILE TO GIT.
#
# ARCHITECTURAL PRINCIPLE:
# Local development uses local providers and emulators (SQLite, Foundry Local,
# Redis local, pgvector Docker, Service Bus emulator, Cosmos emulator).
#
# In Azure staging/production, the application uses:
#   1. Minimal bootstrap environment variables (AZURE_APPCONFIG_ENDPOINT, etc.)
#   2. Microsoft Entra ID / Managed Identity via DefaultAzureCredential (no secrets)
#   3. Azure App Configuration for non-secret runtime configuration
#   4. Azure Key Vault references for unavoidable external secrets only
#
# Staging and production runtimes MUST NOT load .env or .env.local files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME ENVIRONMENT SELECTION
# ------------------------------------------------------------------------------
# Allowed values: local | test | development | staging | production
# (Legacy local compatibility aliases: container | kubernetes-local)
AEGISBANK_ENV=local

# Configuration label used by App Configuration (defaults to environment name)
AEGISBANK_CONFIG_LABEL=local

# ------------------------------------------------------------------------------
# 2. LOCAL CONFIGURATION & EMULATORS (LOCAL ONLY)
# ------------------------------------------------------------------------------
# Use the local Azure App Configuration Emulator (port 8483)
AEGISBANK_USE_APPCONFIG_EMULATOR=true
AEGISBANK_APPCONFIG_EMULATOR_URL=http://127.0.0.1:8483

# Local Core Banking mock service
CORE_BANKING_URL=http://localhost:8000
AEGISBANK_CORE_BANKING_URL=http://localhost:8000
# Optional Core Banking SQLite database DSN (defaults to data/local/aegisbank-dev.db)
# AEGISBANK_DATABASE_URL=sqlite:///data/local/aegisbank-dev.db

# Local Redis cache & vector search accelerator
REDIS_URL=redis://localhost:6379/0

# Local PostgreSQL + pgvector Docker datastore
AEGISBANK_PGVECTOR_URL=postgresql://aegis_user:aegis_password@localhost:5432/aegis_rag

# Local Azure Service Bus Emulator
AEGISBANK_SERVICEBUS_CONN_STR=Endpoint=sb://127.0.0.1;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# Local Azure Cosmos DB Emulator
COSMOS_ENDPOINT=http://127.0.0.1:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# ------------------------------------------------------------------------------
# 3. LOCAL FOUNDRY / LLM (LOCAL ONLY)
# ------------------------------------------------------------------------------
# Foundry Local endpoint override (leave empty for automatic discovery)
AEGISBANK_FOUNDRY_LOCAL_BASE_URL=
AEGISBANK_FOUNDRY_TIMEOUT_SECONDS=45
AEGISBANK_FOUNDRY_MAX_RETRIES=2
# Retries transient local service contention (e.g. Infer Request busy)
AEGISBANK_FOUNDRY_BUSY_MAX_RETRIES=5
AEGISBANK_FOUNDRY_BUSY_RETRY_BASE_SECONDS=2

# Durable Session Store (SQLite embedded datastore for local/test)
AEGISBANK_SESSION_DB_PATH=data/sessions.db

# ------------------------------------------------------------------------------
# 4. CLOUD BOOTSTRAP REFERENCE (FOR AZURE CONTAINER APPS RUNTIME)
# ------------------------------------------------------------------------------
# In Azure staging and production, only the following minimal bootstrap variables
# are injected into the Container App runtime. All service authentication is
# handled passwordlessly via Managed Identity (DefaultAzureCredential).
#
# DO NOT UNCOMMENT THESE IN LOCAL DEVELOPMENT:
# AEGISBANK_ENV=staging
# AZURE_APPCONFIG_ENDPOINT=https://<prefix>-staging-config.azconfig.io
# AZURE_KEY_VAULT_URL=https://<prefix>-staging-kv.vault.azure.net/
# AEGISBANK_SERVICEBUS_NAMESPACE=<prefix>-staging.servicebus.windows.net
# AZURE_OPENAI_ENDPOINT=https://<prefix>-staging-ai.cognitiveservices.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=phi-4-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# AegisBank AI Platform — Local Environment Template
# Copy this file to .env for local development. Never commit real secrets or credentials.

# Foundry Local / Local LLM Endpoint Override (optional; leave empty for auto-discovery)
AEGISBANK_FOUNDRY_LOCAL_BASE_URL=
AEGISBANK_FOUNDRY_TIMEOUT_SECONDS=10
AEGISBANK_FOUNDRY_MAX_RETRIES=2

# Durable Session Store (SQLite embedded datastore; default: data/sessions.db)
AEGISBANK_SESSION_DB_PATH=data/sessions.db

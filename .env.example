# AegisBank AI Platform — Local Environment Template
# Copy this file to .env.local for local development. Never commit real secrets,
# credentials, or a .env.production file. Cloud runtimes use App Configuration,
# Managed Identity, and Key Vault instead of this file.

# This file is loaded only by local developer workflows. It is not a production
# secrets mechanism and staging/production must not automatically load it.
AEGISBANK_ENV=local
AEGISBANK_USE_APPCONFIG_EMULATOR=true
AEGISBANK_APPCONFIG_EMULATOR_URL=http://127.0.0.1:8483

# Foundry Local / Local LLM Endpoint Override (optional; leave empty for auto-discovery)
AEGISBANK_FOUNDRY_LOCAL_BASE_URL=
AEGISBANK_FOUNDRY_TIMEOUT_SECONDS=45
AEGISBANK_FOUNDRY_MAX_RETRIES=2
# Retries only transient local service contention (for example, Infer Request is busy).
AEGISBANK_FOUNDRY_BUSY_MAX_RETRIES=5
AEGISBANK_FOUNDRY_BUSY_RETRY_BASE_SECONDS=2

# Durable Session Store (SQLite embedded datastore; default: data/sessions.db)
AEGISBANK_SESSION_DB_PATH=data/sessions.db

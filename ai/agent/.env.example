# Local-only configuration. Never commit a populated .env file.
# Use the current Foundry Local endpoint, or leave empty for `foundry server status` discovery.
AEGISBANK_FOUNDRY_LOCAL_BASE_URL=
AEGISBANK_FOUNDRY_TIMEOUT_SECONDS=10
AEGISBANK_FOUNDRY_MAX_RETRIES=2
# SQLite session state. `:memory:` is useful for isolated tests.
AEGISBANK_SESSION_DB_PATH=data/sessions.db

# Agent-package local configuration template.
# When copied to ai/agent/.env.local, this file overrides duplicate root values;
# the root .env.local supplies any variables omitted from this agent-specific overlay.
# Process environment variables have highest priority.
# Never commit a populated .env.local file.
# Use the current Foundry Local endpoint, or leave empty for `foundry server status` discovery.
AEGISBANK_FOUNDRY_LOCAL_BASE_URL=
AEGISBANK_FOUNDRY_TIMEOUT_SECONDS=45
AEGISBANK_FOUNDRY_MAX_RETRIES=2
# Retries only transient local service contention (for example, Infer Request is busy).
AEGISBANK_FOUNDRY_BUSY_MAX_RETRIES=5
AEGISBANK_FOUNDRY_BUSY_RETRY_BASE_SECONDS=2
# SQLite session state. `:memory:` is useful for isolated tests.
AEGISBANK_SESSION_DB_PATH=data/sessions.db
